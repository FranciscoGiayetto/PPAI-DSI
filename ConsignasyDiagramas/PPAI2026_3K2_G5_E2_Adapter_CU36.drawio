ounded=0;curved=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="155" y="198" as="sourcePoint"/><mxPoint x="160" y="220" as="targetPoint"/><Array as="points"><mxPoint x="195" y="198"/><mxPoint x="195" y="220"/></Array></mxGeometry></mxCell><mxCell id="din-e14" value="obtenerLocalizacion(datosBolsines: String[][])" style="html=1;verticalAlign=bottom;endArrow=open;endSize=10;dashed=1;curved=0;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="155" y="288" as="sourcePoint"/><mxPoint x="545" y="288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="din-e15" value="new(claveAPI: String)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=10;dashed=1;curved=0;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="575" y="370" as="sourcePoint"/><mxPoint x="905" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="din-e16" value="obtenerLocalizacionBolsines(datosBolsines: String[][]): String[][]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="575" y="440" as="sourcePoint"/><mxPoint x="1005" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="din-e17" value="solicitarLocalizacion(datosBolsines: String[][])" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;rounded=0;curved=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1015" y="475" as="sourcePoint"/><mxPoint x="1020" y="500" as="targetPoint"/><Array as="points"><mxPoint x="1055" y="475"/><mxPoint x="1055" y="500"/></Array></mxGeometry></mxCell><mxCell id="din-e18" value="*getBolsinLocation(apiKey: String, numeroBolsin: int,&lt;br&gt;codigoCMOrigen: String): String" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1015" y="560" as="sourcePoint"/><mxPoint x="1465" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="din-e19" value="adaptarLocalizacion()" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;rounded=0;curved=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1015" y="600" as="sourcePoint"/><mxPoint x="1020" y="625" as="targetPoint"/><Array as="points"><mxPoint x="1055" y="600"/><mxPoint x="1055" y="625"/></Array></mxGeometry></mxCell><mxCell id="din-e20" value="enviarDatosLocalizacion(datosLocalizacion: String[][])" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="705" as="sourcePoint"/><mxPoint x="160" y="705" as="targetPoint"/></mxGeometry></mxCell><mxCell id="din-c21" value="&lt;b&gt;enviarDatosLocalizacion():&lt;/b&gt; la InterfazGPS envía al gestor los datos de localización ya adaptados (matriz String con una fila por bolsín), para que el gestor los ubique en el mapa." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="185" y="738" width="345" height="60" as="geometry"/></mxCell><mxCell id="din-e22" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeWidth=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="738" as="sourcePoint"/><mxPoint x="360" y="706" as="targetPoint"/></mxGeometry></mxCell><mxCell id="din-c23" value="&lt;b&gt;obtenerLocalizacion():&lt;/b&gt; mensaje de la realización de análisis. El gestor crea la InterfazGPS y le solicita la localización de los bolsines enviados, pasando una matriz String con una fila por bolsín: número de bolsín, código de CM origen y código de CM destino.&lt;br&gt;La InterfazGPS, según el modelo de GPS Tracker en uso, crea el adaptador concreto (en este caso AdaptadorGPSXTR4500L) enviándole la clave API de ese modelo, y le delega la obtención y adaptación de los datos." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="185" y="318" width="345" height="138" as="geometry"/></mxCell><mxCell id="din-e24" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeWidth=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="318" as="sourcePoint"/><mxPoint x="330" y="288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="din-c25" value="&lt;b&gt;obtenerLocalizacionBolsines():&lt;/b&gt; método polimórfico con el que la InterfazGPS delega en el adaptador concreto la obtención y adaptación de los datos del GPS Tracker.&lt;br&gt;1. Invoca solicitarLocalizacion() para pedir los datos al servicio.&lt;br&gt;2. Invoca adaptarLocalizacion() para transformar lo recibido.&lt;br&gt;3. Retorna una matriz String con una fila por bolsín: número de bolsín, latitud, longitud y fecha y hora de la última actualización." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="476" width="355" height="118" as="geometry"/></mxCell><mxCell id="din-e26" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeWidth=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="476" as="sourcePoint"/><mxPoint x="790" y="441" as="targetPoint"/></mxGeometry></mxCell><mxCell id="din-c27" value="&lt;b&gt;solicitarLocalizacion():&lt;/b&gt; método polimórfico que adapta el pedido al formato que espera el servicio. Para el XTR-4500L, por cada bolsín toma el número de bolsín (lo transforma a entero) y el código de CM origen, e invoca getBolsinLocation() enviando la clave API (mensaje *getBolsinLocation() de la realización de análisis). Guarda cada JSON (String) recibido." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="340" width="310" height="122" as="geometry"/></mxCell><mxCell id="din-e28" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeWidth=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="462" as="sourcePoint"/><mxPoint x="1200" y="476" as="targetPoint"/></mxGeometry></mxCell><mxCell id="din-c29" value="&lt;b&gt;adaptarLocalizacion():&lt;/b&gt; método polimórfico que adapta la respuesta del servicio. Para el XTR-4500L:&lt;br&gt;1. Toma cada JSON (String) recibido.&lt;br&gt;2. Interpreta cada ítem y extrae número de bolsín, latitud, longitud y fecha y hora de la última actualización.&lt;br&gt;3. Agrupa los datos en una matriz String con una fila por bolsín." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="700" width="380" height="104" as="geometry"/></mxCell><mxCell id="din-e30" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeWidth=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="700" as="sourcePoint"/><mxPoint x="1120" y="622" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>